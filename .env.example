# Copy to .env; never commit .env to Git.
SECRET_KEY=ssp-prod-key-2023-donotshare
DB_PASSWORD=REPLACE_WITH_PRIVATE_POSTGRES_PASSWORD
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
PUBLIC_BASE_URL=http://localhost:8000
# Optional: trusted, HTTPS client metadata hostnames. Leave empty for safer default.
OAUTH_CIMD_ALLOWED_HOSTS=
MCP_JWKS_URL=https://your-domain.example/YOUR-EXISTING-JWKS-PATH

# Step 5 — Evaluation

EVAL_CITIZEN_URL=https://your-domain.example/mcp/citizen
EVAL_OFFICER_URL=https://your-domain.example/mcp/officer

# Temporary test identities:
# Supply actual OAuth access tokens only in the
# deployment runner's private environment.
#
# Do not store tokens in Git or the dashboard service.
EVAL_CITIZEN_A_TOKEN=
EVAL_CITIZEN_B_TOKEN=
EVAL_OFFICER_TOKEN=

# Existing seeded or created test application
# owned by Citizen A, not Citizen B.
EVAL_CITIZEN_A_APPLICATION_NO=
EVAL_CITIZEN_A_EXPECTED_STATUS=

# Private evaluation dashboard credentials
EVAL_DASHBOARD_USERNAME=
EVAL_DASHBOARD_PASSWORD=

# Evaluation report location
EVAL_REPORT_DIR=/var/sewasetu/eval-reports