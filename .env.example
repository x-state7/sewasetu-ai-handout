# AWS / Docker deployment. Do not check the generated .env into version control.
# Use ./seed/demo-seed.sql by default. The original seed/seed.sql is
# a production-labeled export and must be separately authorized before use.
SEVASETU_SEED_FILE=./seed/seed.sql
# Production credentials: configure privately on the VM.

SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
DB_PASSWORD=REPLACE_WITH_EXISTING_DB_PASSWORD

ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PRIVATE_PASSWORD

# Dedicated reviewer role for officer OAuth only; no /admin access.
OFFICER_REVIEWER_USERNAME=reviewer-officer
OFFICER_REVIEWER_PASSWORD=REPLACE_WITH_RANDOM_32_CHAR_SECRET
# Separate credential for seeing ONLY explicitly listed demo OTPs.
REVIEWER_OTP_USERNAME=reviewer-otp
REVIEWER_OTP_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_32_CHAR_SECRET
# Only the synthetic demo-seed.sql mobiles; never use real phone numbers.
REVIEWER_OTP_MOBILES=0000000001,0000000002,0000000008

PUBLIC_HOSTNAME=your-domain.example
PUBLIC_BASE_URL=https://your-domain.example

MCP_JWKS_URL=https://your-domain.example/.well-known/jwks.json

OAUTH_CIMD_ALLOWED_HOSTS=

# Configure only the blocks assigned to this officer.
OFFICER_ALLOWED_BLOCKS=Sonari,Rajapara

# Private evaluation dashboard
EVAL_DASHBOARD_USERNAME=evaluator
EVAL_DASHBOARD_PASSWORD=REPLACE_WITH_24_CHARACTER_PRIVATE_SECRET

# Synthetic evaluation identities
EVAL_CITIZEN_URL=https://your-domain.example/mcp/citizen
EVAL_OFFICER_URL=https://your-domain.example/mcp/officer

EVAL_CITIZEN_A_TOKEN=
EVAL_CITIZEN_B_TOKEN=
EVAL_OFFICER_TOKEN=

EVAL_CITIZEN_A_APPLICATION_NO=
EVAL_CITIZEN_A_EXPECTED_STATUS=

# Genuine AI evaluations (never commit live tokens or API keys)
# Base URL must expose POST /chat/completions and support tool calling.
EVAL_LLM_BASE_URL=
EVAL_LLM_MODEL=
EVAL_LLM_API_KEY=
# Set YES for an isolated, operator-owned HTTP LLM inside a trusted network.
EVAL_ALLOW_INTERNAL_LLM_HTTP=
# DANGEROUS: runs *real* writes on the configured DB. Use a disposable synthetic database.
# EVAL_ENABLE_WRITES=YES_I_AUTHORIZE_SYNTHETIC_TEST_WRITES
EVAL_ENABLE_WRITES=
