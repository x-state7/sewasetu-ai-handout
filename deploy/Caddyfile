{$PUBLIC_HOSTNAME} {
    encode gzip

    @citizenMetadata path /.well-known/oauth-protected-resource/mcp/citizen
    handle @citizenMetadata {
        rewrite * /.well-known/oauth-protected-resource/mcp
        reverse_proxy mcp-citizen:8011
    }

    @officerMetadata path /.well-known/oauth-protected-resource/mcp/officer
    handle @officerMetadata {
        rewrite * /.well-known/oauth-protected-resource/mcp
        reverse_proxy mcp-officer:8012
    }

    @citizen path /mcp/citizen
    handle @citizen {
        rewrite * /mcp
        reverse_proxy mcp-citizen:8011 {
            flush_interval -1
        }
    }

    @officer path /mcp/officer
    handle @officer {
        rewrite * /mcp
        reverse_proxy mcp-officer:8012 {
            flush_interval -1
        }
    }

    @eval path /eval-dashboard
    handle @eval {
        reverse_proxy eval-public:8031
    }

    handle {
        reverse_proxy app:8000
    }
}
